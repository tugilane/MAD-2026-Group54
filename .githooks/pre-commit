#!/bin/sh
set -eu

if [ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ] || [ ! -f graphify-out/graph.json ]; then
    exit 0
fi

if git diff --cached --quiet -- . ':!graphify-out/graph.json'; then
    exit 0
fi

if ! command -v graphify >/dev/null 2>&1; then
    echo "Graphify is required for this commit. Install graphifyy or set GRAPHIFY_SKIP_HOOK=1." >&2
    exit 1
fi

PYTHONHASHSEED=0 graphify update .
git add -- graphify-out/graph.json
